  <version>0.0.1</version>

  <description>
    Custom ROS 2 interfaces for the Mini DOGU multi-robot platform.
  </description>

  <maintainer email="your-email@example.com">
    Seongil Heo
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

