<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot">

  <xacro:arg name="prefix" default=""/>

  <material name="body_color">
    <color rgba="0.25 0.35 0.55 1.0"/>
  </material>

  <link name="$(arg prefix)base_footprint"/>

  <link name="$(arg prefix)base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.55 0.40 0.30"/>
      </geometry>
      <material name="body_color"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.55 0.40 0.30"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="20.0"/>
      <inertia
        ixx="0.416"
        ixy="0.0"
        ixz="0.0"
        iyy="0.654"
        iyz="0.0"
        izz="0.802"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)base_footprint_joint" type="fixed">
    <parent link="$(arg prefix)base_footprint"/>
    <child link="$(arg prefix)base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="$(arg prefix)lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
    </visual>
  </link>

  <joint name="$(arg prefix)lidar_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lidar_link"/>
    <origin xyz="0.15 0 0.36"/>
  </joint>

  <link name="$(arg prefix)camera_link">
    <visual>
      <geometry>
        <box size="0.08 0.10 0.06"/>
      </geometry>
    </visual>
  </link>

  <joint name="$(arg prefix)camera_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)camera_link"/>
    <origin xyz="0.27 0 0.28"/>
  </joint>

</robot>
