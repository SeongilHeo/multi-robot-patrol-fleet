<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_dogu_bringup</name>
  <version>0.0.1</version>

  <description>
      Top-level launch and system orchestration for the Mini DOGU multi-robot platform.
  </description>

  <maintainer email="seongil.e.heo@gmail.com">
    Seongil Heo
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>lifecycle_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>mini_dogu_sim</exec_depend>
  <exec_depend>mini_dogu_safety</exec_depend>
  <exec_depend>mini_dogu_description</exec_depend>
  <exec_depend>mini_dogu_mapping</exec_depend>
  <exec_depend>mini_dogu_fleet</exec_depend>
  <exec_depend>mini_dogu_navigation</exec_depend>
  <exec_depend>mini_dogu_patrol</exec_depend>
  <exec_depend>mini_dogu_scheduler</exec_depend>
  <exec_depend>merge_map</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
